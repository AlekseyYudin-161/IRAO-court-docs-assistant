# LLM: локальная Ollama, OpenAI-совместимый API; смена модели = одна строка
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_TIMEOUT=120
NO_LLM=1                                         # то же, что флаг --no-llm

# Данные
DATA_ROOT=data/courts_anonymized
TESSERACT_CMD=tesseract            # если бинарник не в PATH (conda, Windows)

# Письмо ответственному сотруднику
LAWYER_EMAIL=lawyer@example.local
MAIL_FROM="Помощник по судебным документам <doc-assistant@example.local>"
# Адрес внутри MAIL_FROM должен совпадать с SMTP_USER (имя перед ним — любое), иначе Яндекс отклонит отправку.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=<ящик>@yandex.ru
SMTP_PASSWORD=<пароль приложения>
# Mailpit локально: SMTP_HOST=localhost SMTP_PORT=1025 SMTP_SSL=0